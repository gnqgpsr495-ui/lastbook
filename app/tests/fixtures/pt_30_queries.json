{
  "schema_version": 1,
  "norm": "pt-1",
  "region": "PT-30",
  "index_filename": "PT-30.sqlite",
  "description": "Address and place-search expectations for Madeira (PT-30), for the shared runtime work (#31), grown from the Portugal proposal (#297) and its Madeira pilot (#420). The twelve rows are verbatim rows of the live PT-30 index — the INE address register via the 2026-02-23 OpenAddresses upload — chosen to cover the pt-1 spelling rules and the shapes a Madeira query takes; tools/build_region_pt_30.py check covers the live index.",
  "index_contract": {
    "table": "addr(num TEXT, street TEXT, norm TEXT, city TEXT, state TEXT, zip TEXT, lat REAL, lon REAL, district TEXT)",
    "indexes": [
      "addr_norm ON addr(norm, num)",
      "addr_zip ON addr(zip)"
    ],
    "meta": {
      "region": "PT-30",
      "norm": "pt-1",
      "source": "Instituto Nacional de Estatística, I.P., via OpenAddresses (CC BY 4.0)"
    },
    "rules": [
      "num is the register's house label with leading zeros stripped only when the rest is all digits ('007' becomes '7'; '0E', '013A' and '5 1J' stay as written)",
      "norm is normalize_pt(street), scheme pt-1",
      "city is the INE locality as the register spells it, upper case, sometimes with a municipality suffix, occasionally empty",
      "state is PT-30 in every row; the district column is empty (the register has no district)",
      "zip is the PT postcode NNNN-NNN stored without the hyphen",
      "the index is a sidecar: map-set.json does not list it, as for the US state indexes"
    ]
  },
