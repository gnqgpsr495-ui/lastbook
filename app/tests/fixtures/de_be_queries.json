{
  "schema_version": 1,
  "norm": "de-1",
  "region": "DE-BE",
  "index_filename": "DE-BE.sqlite",
  "description": "Address and place-search expectations for Berlin, for the shared runtime work (#79, #31). The eight address rows are synthetic, written for these cases: every street name is in the live DE-BE index, but several of the houses, postcodes and localities are not, so the rows are not Berlin data. tools/build_region_de_be.py check covers the live index.",
  "index_contract": {
    "table": "addr(num TEXT, street TEXT, norm TEXT, city TEXT, state TEXT, zip TEXT, lat REAL, lon REAL, district TEXT)",
    "indexes": [
      "addr_norm ON addr(norm, num)",
      "addr_zip ON addr(zip)"
    ],
    "meta": {
      "region": "DE-BE",
      "norm": "de-1",
      "source": "Geoportal Berlin (dl-de/zero-2.0)"
    },
    "rules": [
      "num is the house number without leading zeros, with a one-letter suffix in upper case (12A)",
      "norm is normalize_de(street), scheme de-1",
      "city is Berlin and district the Ortsteil",
      "state is DE-BE in every row; a bare DE is Delaware",
      "the index is a sidecar: map-set.json does not list it, as for the US state indexes"
    ]
  },
